@{
    # Windows physical disk / partition to expose.
    Disk        = 0
    Partition   = 2

    # WSL distribution and Linux-side mount settings.
    Distro      = 'Debian'
    FileSystem  = 'btrfs'
    MountPoint  = '/mnt/btrfs'
    Device      = '/dev/nbd0'

    # NBD port. The Windows host IP visible from WSL is detected automatically.
    Port        = 10809

    # Open the mounted path in Windows Explorer after a successful mount.
    OpenExplorer = $true
}
